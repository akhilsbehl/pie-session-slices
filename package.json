{
  "name": "pie-session-slices",
  "version": "0.1.0",
  "description": "Pi extension that captures exact slices of session history with DuckDB-backed turn persistence",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/pie-session-slices.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/pie-session-slices.mjs"
    ]
  },
  "scripts": {
    "build": "tsdown --clean && mv dist/index.mjs dist/pie-session-slices.mjs && mv dist/index.d.mts dist/pie-session-slices.d.mts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-slices.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.80.10",
    "duckdb": "^1.3.3",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "26.1.1",
    "tsdown": "0.22.13",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10 || ^0.81.0"
  },
  "allowScripts": {
    "duckdb@1.4.4": true
  }
}
